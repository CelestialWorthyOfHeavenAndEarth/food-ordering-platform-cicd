# Application
APP_NAME=Feastly
APP_ENV=production
APP_URL=http://your-ec2-ip
APP_DEBUG=false
APP_SECRET=CHANGE_ME_TO_RANDOM_32_CHAR_STRING

# Database
DB_HOST=mysql
DB_PORT=3306
DB_NAME=food_ordering_db
DB_USER=food_user
DB_PASS=CHANGE_ME_STRONG_PASSWORD
DB_CHARSET=utf8mb4

# Session
SESSION_LIFETIME=7200
SESSION_SECURE=true
SESSION_HTTPONLY=true

# Upload limits
MAX_FILE_SIZE=5M
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
